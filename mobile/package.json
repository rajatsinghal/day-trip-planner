{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build-sprites": "tsx scripts/build-sprites.ts",
    "build-map-html": "tsx scripts/build-map-html.ts",
    "build-map": "npm run build-sprites && npm run build-map-html",
    "test": "jest"
  },
  "dependencies": {
    "@dtp/core": "*",
    "@expo/vector-icons": "^14.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~6.12.0",
    "expo": "~54.0.33",
    "expo-application": "~6.0.2",
    "expo-linking": "~7.0.5",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-mmkv": "^3.1.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-svg": "15.11.2",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.13.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "canvas": "^2.11.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts",
      "<rootDir>/__tests__/**/*.test.tsx"
    ],
    "moduleNameMapper": {
      "^@dtp/core$": "<rootDir>/../packages/core/src/index.ts",
      "^@dtp/core/(.*)$": "<rootDir>/../packages/core/src/$1"
    }
  },
  "private": true
}
